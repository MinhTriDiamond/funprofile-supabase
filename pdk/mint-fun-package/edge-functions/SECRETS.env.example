# Secrets cần cấu hình trên Lovable Cloud của LoveHUB
# Đăng ký qua Project Settings → Secrets (KHÔNG commit file này).

# ── FUN Money contract (share với FUN Profile) ──────────────
FUN_MONEY_CONTRACT_ADDRESS=0x39A1b047D5d143f8874888cfa1d30Fb2AE6F0CD6
FUN_MONEY_CHAIN_ID=56
BSC_RPC_URL=https://bsc-dataseed.binance.org

# ── Multisig attester ───────────────────────────────────────
# LoveHUB KHÔNG giữ private key. 3 địa chỉ public của attester
# (share với FUN Profile) — dùng để verify sig trước khi submit.
PPLP_ATTESTER_PUBLIC_ADDRESSES=0xATTESTER1,0xATTESTER2,0xATTESTER3

# Webhook HTTPS về FUN Profile để lấy 2/3 chữ ký EIP-712.
# FUN Profile expose endpoint `pplp-attester-sign-external`.
FUN_PROFILE_ATTESTER_URL=https://funprofile.lovable.app/functions/v1/pplp-attester-sign-external
FUN_PROFILE_ATTESTER_SHARED_SECRET=<HMAC secret dùng chung với FUN Profile>

# ── Auto-submit relayer (LoveHUB dev wallet) ────────────────
# Wallet trả gas cho lockWithPPLP. Nạp BNB đủ trước khi bật.
PPLP_RELAYER_PRIVATE_KEY=<0x... private key relayer riêng của LoveHUB>

# ── Supabase (Lovable Cloud tự cấp) ─────────────────────────
SUPABASE_URL=<auto>
SUPABASE_SERVICE_ROLE_KEY=<auto>
SUPABASE_ANON_KEY=<auto>
